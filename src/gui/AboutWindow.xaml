<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About WinTuner" Height="320" Width="500" MinHeight="320" MinWidth="500"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    UseLayoutRounding="True"
    FontFamily="Segoe UI"
    Background="#14161B"
    TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- ===== Palette ===== -->
        <SolidColorBrush x:Key="Bg.Window"     Color="#14161B" />
        <SolidColorBrush x:Key="Bg.Panel"      Color="#1B1E25" />
        <SolidColorBrush x:Key="Bg.Input"      Color="#23272F" />
        <SolidColorBrush x:Key="Border.Strong" Color="#3B414D" />
        <SolidColorBrush x:Key="Text.Primary"  Color="#E7E9ED" />
        <SolidColorBrush x:Key="Text.Muted"    Color="#969CA8" />
        <SolidColorBrush x:Key="Accent"        Color="#E3A436" />
        <SolidColorBrush x:Key="Accent.Hover"  Color="#F2B753" />

        <!-- ===== Button ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground"        Value="#1A1306" />
            <Setter Property="Background"         Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush"        Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness"    Value="1" />
            <Setter Property="FontFamily"         Value="Bahnschrift SemiBold" />
            <Setter Property="FontSize"           Value="12" />
            <Setter Property="Padding"            Value="20,6" />
            <Setter Property="Cursor"             Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"  Value="{StaticResource Accent.Hover}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Accent.Hover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C98A26" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Viewbox Width="48" Height="48" Stretch="Uniform">
                <Canvas Width="64" Height="64">
                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="60" Height="60" Fill="#0078D4" />
                    <Rectangle Canvas.Left="18" Canvas.Top="18" Width="14" Height="14" Fill="White" RadiusX="2" RadiusY="2" />
                    <Rectangle Canvas.Left="36" Canvas.Top="18" Width="14" Height="14" Fill="White" RadiusX="2" RadiusY="2" />
                    <Rectangle Canvas.Left="18" Canvas.Top="36" Width="14" Height="14" Fill="White" RadiusX="2" RadiusY="2" />
                    <Rectangle Canvas.Left="36" Canvas.Top="36" Width="14" Height="14" Fill="White" RadiusX="2" RadiusY="2" />
                    <Line Canvas.Left="34" Canvas.Top="10" X2="34" Y2="14" Stroke="White" StrokeThickness="2" />
                    <Line Canvas.Left="34" Canvas.Top="54" X2="34" Y2="58" Stroke="White" StrokeThickness="2" />
                    <Line Canvas.Left="10" Canvas.Top="34" X2="14" Y2="34" Stroke="White" StrokeThickness="2" />
                    <Line Canvas.Left="54" Canvas.Top="34" X2="58" Y2="34" Stroke="White" StrokeThickness="2" />
                </Canvas>
            </Viewbox>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="WinTuner" FontFamily="Bahnschrift SemiBold"
                           FontSize="22" Foreground="{StaticResource Text.Primary}" />
                <TextBlock Text="Windows system tuning utility" FontFamily="Bahnschrift"
                           FontSize="12" Foreground="{StaticResource Text.Muted}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Content -->
        <Border Grid.Row="1" Background="{StaticResource Bg.Panel}"
                BorderBrush="{StaticResource Border.Strong}" BorderThickness="1" Padding="20">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Version:" 
                               Foreground="{StaticResource Text.Muted}" 
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="txt_Version" Grid.Column="1" 
                               Foreground="{StaticResource Text.Primary}" 
                               VerticalAlignment="Center" />
                </Grid>
                
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Author:" 
                               Foreground="{StaticResource Text.Muted}" 
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Ief" 
                               Foreground="{StaticResource Text.Primary}" 
                               VerticalAlignment="Center" />
                </Grid>
                
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="PowerShell:" 
                               Foreground="{StaticResource Text.Muted}" 
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" x:Name="txt_PowerShellVersion" 
                               Foreground="{StaticResource Text.Primary}" 
                               VerticalAlignment="Center" />
                </Grid>
                
                <Separator Margin="0,8,0,12" Background="{StaticResource Border.Strong}" />
                
                <TextBlock Text="A local-only Windows system tuning utility for optimizing"
                           Foreground="{StaticResource Text.Muted}" 
                           TextWrapping="Wrap" Margin="0,0,0,4" />
                <TextBlock Text="performance, managing features, and customizing settings."
                           Foreground="{StaticResource Text.Muted}" 
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Close button -->
        <Button x:Name="btn_Close" Grid.Row="2" Content="Close" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right" Margin="0,20,0,0" 
                Width="80" Height="32" />
    </Grid>
</Window>
